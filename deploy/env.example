# /etc/scr100-gateway.env  (chmod 600, root-owned -- holds the API key)
# SCR100_HOST is the device's LAN IP *at its own site*. Every GP2 site is
# 192.168.1.0/24, so the same address can be a different machine elsewhere.
SCR100_HOST=192.168.1.201
SCR100_PORT=4370
SCR100_PASSWORD=0
SCR100_TIMEOUT_SECONDS=8.0
SCR100_FORCE_UDP=true
SCR100_OMMIT_PING=true
SCR100_ENABLE_WRITES=true
# Same value card-pipeline has as SCR100_API_KEY. Never commit the real one:
#   ssh <deploy-host> 'docker exec card-pipeline printenv SCR100_API_KEY'
SCR100_API_KEY=CHANGE_ME
